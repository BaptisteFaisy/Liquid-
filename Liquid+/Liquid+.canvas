		{"id":"ae7c78dc164d97d8","type":"text","text":"chaque jour, envoyer une invitation de connection à 5-10 personnes de l'écosystème VC parisien avec une note courte et personnalisée","x":2657,"y":-339,"width":263,"height":159},
