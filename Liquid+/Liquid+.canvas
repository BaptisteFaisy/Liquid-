		{"id":"7529802c2306ab15","type":"text","text":"le hook (1-3 lignes) \npuis phrases courtes\nbcp de blancs\nune idée par ligne\nune seule idée par post\nfinir par une question\n1 à 3 hashtags de niche","x":2962,"y":859,"width":305,"height":201},
