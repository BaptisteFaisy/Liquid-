		{"id":"4b2c9558adce7931","type":"text","text":"15 minutes par jour à commenter intelligemment les posts des gros comptes VC","x":2675,"y":-129,"width":285,"height":109},
		{"id":"77d932f758d80ab4","type":"text","text":"faire des posts avec un fil conducteur, une cohérence : par exemple sur le VC et la liquidité des marchés financiers","x":2704,"y":0,"width":276,"height":146},
